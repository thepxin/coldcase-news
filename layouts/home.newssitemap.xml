{{- /* Google News sitemap: articles published in the last 2 days (Google's rule). Listed in robots.txt. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
{{- $cut := now.AddDate 0 0 -2 }}
{{- range first 1000 (where site.RegularPages "Section" "posts").ByPublishDate.Reverse }}
{{- if and (.PublishDate.After $cut) (not .Draft) (partial "is_case.html" .) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <news:news>
      <news:publication>
        <news:name>ColdCaseTech</news:name>
        <news:language>en</news:language>
      </news:publication>
      <news:publication_date>{{ .PublishDate.Format "2006-01-02T15:04:05Z07:00" }}</news:publication_date>
      <news:title>{{ .Title | plainify | htmlUnescape }}</news:title>
    </news:news>
  </url>
{{- end }}
{{- end }}
</urlset>
